# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: defaults to a local SQLite file. For PostgreSQL, set DB_ENGINE and
# fill in the PG* values below.
DB_ENGINE=sqlite
PGDATABASE=northbridge
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=127.0.0.1
PGPORT=5432

# MQTT device integration. Replace CANDIDATE_ID with the assigned ID.
MQTT_ENABLED=true
CANDIDATE_ID=CAND-XXX
MQTT_URL=mqtt://152.42.238.142:1883
